datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String
  users     User[]

  @@map("roles")
}

model User {
  user_id    Int          @id @default(autoincrement())
  role_id    Int
  role       Role         @relation(fields: [role_id], references: [role_id])
  full_name  String
  mobile     String?      @unique
  email      String?      @unique
  expo_push_token String?
  status     String       @default("active")
  created_at DateTime     @default(now())
  profile    UserProfile?
  reviews    Review[]
  bookings   Booking[]
  vendor     Vendor?
  notifications Notification[]

  @@map("users")
}

model UserProfile {
  user_id   Int     @id
  user      User    @relation(fields: [user_id], references: [user_id])
  latitude  Float?
  longitude Float?
  address   String?

  @@map("user_profiles")
}

model Agent {
  agent_id           Int      @id @default(autoincrement())
  name               String
  mobile             String?  @unique
  email              String?  @unique
  referral_code      String   @unique
  commission_balance Decimal  @default(0) @db.Decimal(10, 2)
  approval_status    String   @default("pending")
  created_at         DateTime @default(now())
  vendors            Vendor[]
  payout_requests    PayoutRequest[]

  @@map("agents")
}

model Vendor {
  vendor_id              Int                  @id
  agent_id               Int?
  category_id            Int?
  user                   User                 @relation(fields: [vendor_id], references: [user_id])
  agent                  Agent?               @relation(fields: [agent_id], references: [agent_id])
  category               ServiceCategory?     @relation(fields: [category_id], references: [category_id])
  business_name          String
  owner_name             String?
  mobile                 String?              @unique
  email                  String?              @unique
  whatsapp_number        String?              @unique
  description            String?
  address                String?
  latitude               Float?
  longitude              Float?
  logo_url               String?
  banner_url             String?
  approval_status        String               @default("pending")
  is_available           Boolean              @default(false)
  created_at             DateTime             @default(now())
  services               VendorService[]
  reels                  Reel[]
  availability_schedule  VendorAvailability[]
  gallery                VendorGallery[]
  announcements          Announcement[]

  @@map("vendors")
}

model ServiceCategory {
  category_id   Int             @id @default(autoincrement())
  category_name String
  icon_name     String          @default("general")
  vendors       Vendor[]
  services      VendorService[]

  @@map("service_categories")
}

model VendorService {
  id              Int             @id @default(autoincrement())
  vendor_id       Int
  category_id     Int
  vendor          Vendor          @relation(fields: [vendor_id], references: [vendor_id])
  category        ServiceCategory @relation(fields: [category_id], references: [category_id])
  service_title   String
  description     String?
  price_min       Decimal?        @db.Decimal(10, 2)
  price_max       Decimal?        @db.Decimal(10, 2)
  is_available    Boolean         @default(true)
  approval_status String          @default("pending")
  status          String          @default("pending")
  image_urls      String[]        @default([])
  bookings        Booking[]

  @@map("vendor_services")
}

model Booking {
  booking_id        Int           @id @default(autoincrement())
  user_id           Int
  vendor_service_id Int
  booking_status    String        @default("pending")
  completion_otp    String?
  completion_otp_generated_at DateTime?
  completion_otp_verified_at DateTime?
  booking_date      String?
  booking_time      String?
  scheduled_at      DateTime?
  address           String?
  notes             String?
  commission_earned Decimal?      @db.Decimal(10, 2)
  total_price       Decimal?      @db.Decimal(10, 2)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  user              User          @relation(fields: [user_id], references: [user_id])
  vendor_service    VendorService @relation(fields: [vendor_service_id], references: [id])
  review            Review?
  notifications     Notification[]

  @@map("bookings")
}

model Review {
  review_id  Int     @id @default(autoincrement())
  booking_id Int     @unique
  user_id    Int
  booking    Booking @relation(fields: [booking_id], references: [booking_id])
  user       User    @relation(fields: [user_id], references: [user_id])
  rating     Int
  comment    String?

  @@map("reviews")
}

model Notification {
  notification_id    Int       @id @default(autoincrement())
  recipient_user_id  Int
  booking_id         Int?
  title              String
  message            String
  type               String?   @default("general")
  is_read            Boolean   @default(false)
  read_at            DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  recipient          User      @relation(fields: [recipient_user_id], references: [user_id])
  booking            Booking?  @relation(fields: [booking_id], references: [booking_id])

  @@index([recipient_user_id, is_read])
  @@index([booking_id])
  @@map("notifications")
}

model Reel {
  id            Int      @id @default(autoincrement())
  vendor_id     Int
  vendor        Vendor   @relation(fields: [vendor_id], references: [vendor_id])
  video_url     String
  caption       String?
  category_id   Int?
  thumbnail_url String?
  view_count    Int      @default(0)
  approval_status String @default("pending")
  status        String   @default("pending")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  expiry_date   DateTime?

  @@map("reels")
}

model VendorAvailability {
  availability_id Int      @id @default(autoincrement())
  vendor_id       Int
  vendor          Vendor   @relation(fields: [vendor_id], references: [vendor_id])
  day_of_week     Int
  is_active       Boolean  @default(false)
  start_time      String
  end_time        String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([vendor_id, day_of_week])
  @@map("vendor_availability")
}

model OTPVerification {
  otp_id     Int      @id @default(autoincrement())
  contact    String
  otp_code   String
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("otp_verifications")
}

model PayoutRequest {
  payout_id       Int      @id @default(autoincrement())
  agent_id        Int
  amount          Decimal  @db.Decimal(10, 2)
  account_number  String?
  ifsc_code       String?
  bank_name       String?
  payout_method   String   @default("BANK")
  upi_id          String?
  status          String   @default("pending")
  proof_image_url String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  agent           Agent    @relation(fields: [agent_id], references: [agent_id])

  @@map("payout_requests")
}

model VendorGallery {
  id         Int      @id @default(autoincrement())
  vendor_id  Int
  vendor     Vendor   @relation(fields: [vendor_id], references: [vendor_id])
  image_url  String
  caption    String?
  created_at DateTime @default(now())

  @@map("vendor_gallery")
}

model Announcement {
  announcement_id     Int      @id @default(autoincrement())
  vendor_id           Int?
  vendor              Vendor?  @relation(fields: [vendor_id], references: [vendor_id])
  message             String
  image_url           String?
  location_identifier String
  start_at            DateTime @default(now())
  expires_at          DateTime?
  is_active           Boolean  @default(true)
  approval_status     String   @default("pending")
  status              String   @default("pending")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([location_identifier, is_active, created_at])
  @@map("announcements")
}
