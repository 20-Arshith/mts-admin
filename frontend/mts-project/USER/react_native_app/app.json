{
  "expo": {
    "name": "MYTOWNSERVICES",
    "slug": "react_native_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mytownservices",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "package": "com.mytownservice.user",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eb5e5b45-d423-4fdb-bd54-915a421f9295"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#007BFF",
          "defaultChannel": "mts-default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "./plugins/withAndroidHttpSupport"
    ],
    "extra": {
      "eas": {
        "projectId": "ba1bb462-dee2-4e58-8df0-0f6ab815a3a3"
      }
    },
    "owner": "arshithkakarla"
  }
}
