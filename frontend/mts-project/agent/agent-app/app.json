{
  "expo": {
    "name": "MTS Agent",
    "slug": "agent-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mtsagent",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#01164B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#01164B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mytownservice.agent",
      "versionCode": 14,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c76b5598-01f8-4ee2-8386-b376867eaa6f"
    },
    "plugins": [
      "./plugins/withAndroidHttpSupport",
      "expo-location"
    ],
    "owner": "arshith1s-team",
    "extra": {
      "eas": {
        "projectId": "c76b5598-01f8-4ee2-8386-b376867eaa6f"
      }
    }
  }
}
