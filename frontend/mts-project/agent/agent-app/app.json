{
  "expo": {
    "name": "MTS Agent",
    "slug": "agent-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mtsagent",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#01164B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#01164B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mytownservice.agent",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d0730ce3-8092-47be-9a04-7d57bc81a6aa"
    },
    "plugins": [
      "./plugins/withAndroidHttpSupport",
      "expo-location"
    ],
    "extra": {
      "eas": {
        "projectId": "488334c2-a8e0-476e-8eed-f21004e2fe8c"
      }
    },
    "owner": "arshithkakarla"
  }
}
