{
  "expo": {
    "name": "MTS VENDORS",
    "slug": "tempVendor",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mtsvendors",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#01164B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mytownservice.vendor",
      "versionCode": 18,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to let you upload a business logo, banner, service images, and portfolio gallery.",
          "cameraPermission": "The app needs access to your camera to let you take photos for your services and portfolio."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007BFF",
          "defaultChannel": "mts-default"
        }
      ],
      "./plugins/withAndroidHttpSupport"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "owner": "arshith1",
    "extra": {
      "eas": {
        "projectId": "5ce6f681-b8d8-4f9c-8092-6698304971b2"
      }
    }
  }
}
